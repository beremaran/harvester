# Port the harvester service listens on and is exposed on
PORT=8080

# Required: shared secret clients must present to call the API.
# Set either API_KEY directly, or API_KEY_FILE to read it from a file
# (e.g. a Docker/Compose secret mounted at /run/secrets/api_key).
API_KEY=
#API_KEY_FILE=/run/secrets/api_key

# Required: comma-separated list of hostnames the harvester is allowed to fetch
ALLOWED_HOSTS=

# Allow navigation to private/internal network addresses (SSRF risk if enabled)
ALLOW_PRIVATE_NETWORKS=false

# Capture and store secret values discovered during scraping
CAPTURE_SECRET_VALUES=false

# Max number of concurrent browser sessions/tasks
MAX_CONCURRENCY=2

# Navigation timeout in milliseconds
NAVIGATION_TIMEOUT_MS=45000

# Max HTML payload size to capture, in bytes
MAX_HTML_BYTES=2000000

# Max response body size to capture, in bytes
MAX_BODY_BYTES=65536

# JSON object of extra headers to send when bypassing anti-bot protections
BYPASS_HEADERS_JSON=

# Allow insecure bypass headers (e.g. over plain HTTP)
ALLOW_INSECURE_BYPASS_HEADERS=false

# Allow callers to pass custom headers through to the target site
ALLOW_CALLER_HEADERS=false

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
